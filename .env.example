# Copy this file to .env and fill in your details
# NEVER commit .env to GitHub

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with 'repo' scope (needs write access to LIVE_GITHUB_REPO)
GITHUB_TOKEN=ghp_your_token_here

# The GitHub Pages repo that serves the live site (separate from this CMS repo)
# e.g. yourusername/jabchem-live  — must already exist on GitHub
LIVE_GITHUB_REPO=yourusername/jabchem-live

# Branch to push to (GitHub Pages usually uses main or gh-pages)
LIVE_GITHUB_BRANCH=main

# ── Paths (Docker) ────────────────────────────────────────────────────────────
# Where the live repo is cloned inside the container (volume-mounted)
# Default: /app/live-site  — matches docker-compose.yml volume
LIVE_REPO_PATH=/app/live-site

# ── Domains ───────────────────────────────────────────────────────────────────
# Domain used in the "Open preview" link shown in the admin UI after a build.
# Set this to your reverse-proxy domain so the button opens the right URL.
# Leave blank to auto-detect the LAN IP (useful for local dev).
PREVIEW_DOMAIN=demo.sgt.me.uk

# ── Git identity (used when committing to the live repo) ─────────────────────
GIT_USER_NAME=JABchem CMS
GIT_USER_EMAIL=cms@jabchem.org.uk

# ── Development ───────────────────────────────────────────────────────────────
# Set to 'true' to enable Flask debug mode (local dev only — never in production)
FLASK_DEBUG=false
